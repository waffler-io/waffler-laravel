{
  "name": "waffler/waffler-laravel",
  "description": "Laravel wrapper for waffler/waffler",
  "type": "library",
  "require": {
    "php": "^8.4",
    "waffler/waffler": "^3.1.0",
    "illuminate/support": "^12.0"
  },
  "require-dev": {
    "mockery/mockery": "^1.3",
    "phpunit/phpunit": "^11.0",
    "jetbrains/phpstorm-attributes": "dev-master",
    "friendsofphp/php-cs-fixer": "^v3.68.5",
    "orchestra/testbench": "^v10.4.0",
    "phpstan/phpstan": "^2.1"
  },
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Waffler\\Laravel\\": "src/WafflerLaravel/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Waffler\\Laravel\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "ErickJMenezes",
      "email": "erickmenezes.dev@gmail.com"
    }
  ],
  "scripts": {
    "phpstan": "@php ./vendor/bin/phpstan analyse -c phpstan.neon",
    "phpunit": "./vendor/bin/phpunit --configuration phpunit.xml",
    "php-cs-fixer": "./vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --allow-risky=yes",
    "post-autoload-dump": [
      "@php ./vendor/bin/testbench package:discover --ansi"
    ],
    "test": "@phpunit",
    "lint": "@phpstan",
    "style": "@php-cs-fixer"
  },
  "minimum-stability": "stable",
  "extra": {
    "laravel": {
      "providers": [
        "Waffler\\Laravel\\WafflerServiceProvider"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "phpunit/phpunit": true,
      "friendsofphp/php-cs-fixer": true
    }
  }
}
